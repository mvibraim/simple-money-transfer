{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(./.env.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ],
    "allow": [
      "Bash(./gradlew test:*)",
      "Bash(./gradlew build:*)",
      "Bash(./gradlew check:*)",
      "Bash(./gradlew checkFormat:*)",
      "Bash(./gradlew format:*)",
      "Bash(./gradlew assemble:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-format.sh",
            "timeout": 120,
            "statusMessage": "Checking Spring Java Format…"
          }
        ]
      }
    ]
  }
}
