# Copy this file to .env and fill in real values. .env is gitignored.

POSTGRES_DB=money
POSTGRES_USER=money
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/money
SPRING_DATASOURCE_USERNAME=money
SPRING_DATASOURCE_PASSWORD=change-me

# Must be at least 32 characters. Generate with: openssl rand -hex 32
API_CLIENT_ID=local-dev-client
API_KEY=change-me-to-a-random-32-plus-character-secret
