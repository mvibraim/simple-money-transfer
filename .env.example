# Copy this file to .env and fill in real values. .env is gitignored.

POSTGRES_DB=money
POSTGRES_USER=money
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Flyway migrates as the schema owner (the POSTGRES_USER above) - it's the
# only role with DDL rights, and V6 uses it to create money_app.
SPRING_FLYWAY_USER=money
SPRING_FLYWAY_PASSWORD=change-me

# The running application connects as money_app instead (F16) - a
# least-privilege role V6 creates with this password, which can insert
# and read everywhere but never UPDATE or DELETE ledger_entry, transfer,
# or idempotency_record.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/money
SPRING_DATASOURCE_USERNAME=money_app
SPRING_DATASOURCE_PASSWORD=change-me-app

# Must be at least 32 characters. Generate with: openssl rand -hex 32
API_CLIENT_ID=local-dev-client
API_KEY=change-me-to-a-random-32-plus-character-secret
